# Bitcoin Knots RPC endpoint and dedicated credentials.
BITCOIN_RPC_SCHEME=http
BITCOIN_RPC_HOST=192.168.1.10
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=bpm
BITCOIN_RPC_PASSWORD=change-me
# To use a mounted secret, clear BITCOIN_RPC_PASSWORD and set its container path.
BITCOIN_RPC_PASSWORD_FILE=
BITCOIN_RPC_VERIFY_TLS=true
BITCOIN_RPC_TIMEOUT=30
BITCOIN_NETWORK=main
BPM_RPC_STARTUP_TIMEOUT=30

# Published image (a tag or digest can pin a deployment).
BPM_IMAGE=ghcr.io/spyhunter493/bitcoin-peer-map:latest

# Host interface and port; use 127.0.0.1 behind a local reverse proxy.
BPM_HOST_BIND=0.0.0.0
BPM_HOST_PORT=58333
# Internal listener; normally leave this at its default.
BPM_LISTEN_PORT=58333

# Keep this volume name when upgrading to preserve cached data and preferences.
BPM_DATA_VOLUME=bitcoin-peer-map-data

# Persistent GeoIP database and optional saved-preference override.
BPM_GEOIP_ENABLED=true
BPM_GEOIP_AUTO_UPDATE=
