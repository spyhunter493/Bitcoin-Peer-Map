    "/api/geodb/db-only": {
      "post": {
        "summary": "Set Database-only Mode",
        "operationId": "set_geodb_db_only",
        "description": "Set enabled=true to disable external peer location lookups. The dashboard API Lookup checkbox uses the inverse of this setting. Settings are persisted before changing live state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnabledRequest"
              }
            }
          }
        },
        "responses": {
          "403": {
            "$ref": "#/components/responses/CrossOriginRequest"
          },
          "401": {
            "$ref": "#/components/responses/AdminRequired"
          },
          "429": {
            "$ref": "#/components/responses/AdminRateLimited"
          },
          "200": {
            "description": "Authoritative saved setting. Identical requests do not rewrite settings or reset scheduling.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "geo_db_only_mode",
                    "message"
                  ],
                  "properties": {
                    "geo_db_only_mode": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Missing or non-boolean enabled value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 64 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "AdminToken": []
          }
        ]
      }
    },
    "/api/geodb/auto-update": {
      "post": {
        "summary": "Set Automatic GeoIP Updates",
        "operationId": "set_geodb_auto_update",
        "description": "Enabling schedules an immediate update. Disabling cancels future scheduling and lets an active import finish. Settings are persisted before changing live state.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnabledRequest"
              }
            }
          }
        },
        "responses": {
          "403": {
            "$ref": "#/components/responses/CrossOriginRequest"
          },
          "401": {
            "$ref": "#/components/responses/AdminRequired"
          },
          "429": {
            "$ref": "#/components/responses/AdminRateLimited"
          },
          "200": {
            "description": "Authoritative saved setting. Identical requests do not rewrite settings or reset scheduling.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "auto_update",
                    "message"
                  ],
                  "properties": {
                    "auto_update": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Missing or non-boolean enabled value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 64 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "AdminToken": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddressRequest": {
        "properties": {
          "address": {
            "type": "string",
            "title": "Address",
            "default": ""
          }
        },
        "type": "object",
        "title": "AddressRequest"
      },
      "PeerIdRequest": {
        "properties": {
          "peer_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Peer Id"
          }
        },
        "type": "object",
        "title": "PeerIdRequest"
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Description of the request error."
          },
          "code": {
            "type": "string",
            "description": "Optional machine-readable error code, including admin_required, management_disabled, admin_rate_limited, endpoint_retired, or rpc_busy."
          }
        }
      },
      "UpdateStatus": {
        "type": "object",
        "required": [
          "update_available",
          "latest_version",
          "changes_url",
          "checked_at",
          "check_failed"
        ],
        "properties": {
          "update_available": {
            "type": "boolean",
            "description": "Whether the latest published stable release has a higher semantic version than the installed release."
          },
          "latest_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest published stable release tag; null before a check or when no release exists."
          },
          "changes_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "GitHub Release notes URL for a newer stable release; null when no update is available."
          },
          "checked_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Unix timestamp in seconds of the last completed check, including failures."
          },
          "check_failed": {
            "type": "boolean",
            "description": "Whether the last check failed. A previously known update is retained."
          }
        }
      },
      "ProviderHealth": {
        "type": "object",
        "required": [
          "state",
          "consecutive_failures",
          "last_error",
          "last_success_at",
          "last_failure_at",
          "retry_at"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "unknown",
              "healthy",
              "unavailable",
              "rate_limited"
            ]
          },
          "consecutive_failures": {
            "type": "integer",
            "minimum": 0
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_success_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Unix timestamp in seconds."
          },
          "last_failure_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Unix timestamp in seconds."
          },
          "retry_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Provider requests resume at or after this Unix timestamp. Null means no cooldown. Quota headers and provider outage backoff govern attempts independently of the reachability probe. After five consecutive failures, outage backoff starts at 30 seconds and doubles to a five-minute maximum."
          }
        }
      },
      "ConnectivityStatus": {
        "type": "object",
        "required": [
          "internet_state",
          "api_available",
          "api_consecutive_failures",
          "geo_db_only_mode",
          "api_down_prompt",
          "providers"
        ],
        "properties": {
          "internet_state": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
              "red"
            ],
            "description": "Independent internet reachability probe status."
          },
          "api_available": {
            "type": "boolean",
            "description": "GeoIP has fewer than five consecutive failures and is outside its rate-limit cooldown."
          },
          "api_consecutive_failures": {
            "type": "integer",
            "minimum": 0,
            "description": "Consecutive GeoIP failures only."
          },
          "geo_db_only_mode": {
            "type": "boolean"
          },
          "api_down_prompt": {
            "type": "boolean"
          },
          "providers": {
            "type": "object",
            "required": [
              "geoip"
            ],
            "properties": {
              "geoip": {
                "$ref": "#/components/schemas/ProviderHealth"
              }
            }
          }
        }
      },
      "BitcoinNetwork": {
        "type": "object",
        "required": [
          "chain",
          "default_peer_port"
        ],
        "properties": {
          "chain": {
            "type": "string",
            "enum": [
              "main",
              "test",
              "testnet4",
              "signet",
              "regtest"
            ]
          },
          "default_peer_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Default P2P connection port for the configured chain; independent of BITCOIN_RPC_PORT."
          }
        }
      },
      "EnabledRequest": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Desired state; repeating the same value is a no-op."
          }
        }
      },
      "Peer": {
        "type": "object",
        "required": [
          "ping_ms",
          "geo"
        ],
        "properties": {
          "ping_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Measured ping in fractional milliseconds. Null means no valid measurement; measured zero is valid."
          },
          "geo": { "$ref": "#/components/schemas/GeoMetadata" }
        },
        "additionalProperties": true
      },
      "GeoMetadata": {
        "type": "object",
        "required": ["source", "observed_at", "age_seconds", "freshness", "stale_after_seconds"],
        "properties": {
          "source": {
            "type": ["string", "null"],
            "enum": ["dataset", "ip_api", "unknown", null],
            "description": "Provenance of the winning location record. Legacy records report unknown; absent locations report null."
          },
          "observed_at": {
            "type": ["integer", "null"],
            "description": "Location observation Unix timestamp, not dataset download time."
          },
          "age_seconds": {
            "type": ["integer", "null"], "minimum": 0,
            "description": "Seconds since observation; null for missing, zero, or future timestamps."
          },
          "freshness": {
            "type": "string", "enum": ["fresh", "stale", "unknown", "unavailable"],
            "description": "Usable locations become stale at 30 days. Stale and unknown-age public locations refresh when API lookup is enabled; existing coordinates remain usable. Failed refreshes retry after one hour, and missing locations retry after one minute."
          },
          "stale_after_seconds": { "type": "integer", "const": 2592000 }
        }
      }
    },
    "responses": {
      "CrossOriginRequest": {
        "description": "Browser requests whose Origin host does not match Host are rejected. Reverse proxies must preserve the external Host header. Management is also rejected when BPM_ADMIN_TOKEN is not configured (code: management_disabled).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AdminRequired": {
        "description": "Missing or incorrect admin token. The action was not executed.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AdminRateLimited": {
        "description": "Authentication cooldown for the socket connection address. All management requests, including valid tokens, are rejected until Retry-After expires. Untracked addresses are also rejected while all 1,024 active windows are occupied.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RpcBusy": {
        "description": "RPC capacity exhausted (8 active calls and 32 queued calls). No RPC was dispatched for the rejected operation. Mutations are never retried automatically.",
        "headers": {
          "Retry-After": {
            "description": "Retry delay in seconds.",
            "schema": {
              "type": "integer",
              "const": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "detail": "Bitcoin RPC is busy; try again shortly",
              "code": "rpc_busy"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "AdminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Shared admin token configured with BPM_ADMIN_TOKEN. Use HTTPS. When unset, management is read-only."
      }
    }
  }
}
