  "components": {
    "schemas": {
      "AddressRequest": {
        "properties": {
          "address": {
            "type": "string",
            "title": "Address",
            "default": ""
          }
        },
        "type": "object",
        "title": "AddressRequest"
      },
      "PeerIdRequest": {
        "properties": {
          "peer_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Peer Id"
          }
        },
        "type": "object",
        "title": "PeerIdRequest"
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Description of the request error."
          }
        }
      },
      "UpdateStatus": {
        "type": "object",
        "required": [
          "update_available",
          "latest_version",
          "changes_url",
          "checked_at",
          "check_failed"
        ],
        "properties": {
          "update_available": {
            "type": "boolean",
            "description": "Whether the latest published stable release has a higher semantic version than the installed release."
          },
          "latest_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest published stable release tag; null before a check or when no release exists."
          },
          "changes_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "GitHub Release notes URL for a newer stable release; null when no update is available."
          },
          "checked_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Unix timestamp in seconds of the last completed check, including failures."
          },
          "check_failed": {
            "type": "boolean",
            "description": "Whether the last check failed. A previously known update is retained."
          }
        }
      },
      "ProviderHealth": {
        "type": "object",
        "required": [
          "state",
          "consecutive_failures",
          "last_error",
          "last_success_at",
          "last_failure_at",
          "retry_at"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "unknown",
              "healthy",
              "unavailable",
              "rate_limited"
            ]
          },
          "consecutive_failures": {
            "type": "integer",
            "minimum": 0
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_success_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Unix timestamp in seconds."
          },
          "last_failure_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Unix timestamp in seconds."
          },
          "retry_at": {
            "type": [
              "number",
              "null"
            ],
            "description": "Provider requests resume at or after this Unix timestamp. Null means no cooldown."
          }
        }
      },
      "ConnectivityStatus": {
        "type": "object",
        "required": [
          "internet_state",
          "api_available",
          "api_consecutive_failures",
          "last_price_error",
          "last_known_price",
          "last_price_currency",
          "geo_db_only_mode",
          "api_down_prompt",
          "providers"
        ],
        "properties": {
          "internet_state": {
            "type": "string",
            "enum": [
              "green",
              "yellow",
              "red"
            ],
            "description": "Independent internet reachability probe status."
          },
          "api_available": {
            "type": "boolean",
            "description": "GeoIP has fewer than five consecutive failures and is outside its rate-limit cooldown."
          },
          "api_consecutive_failures": {
            "type": "integer",
            "minimum": 0,
            "description": "Consecutive GeoIP failures only."
          },
          "last_price_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_known_price": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_price_currency": {
            "type": "string"
          },
          "geo_db_only_mode": {
            "type": "boolean"
          },
          "api_down_prompt": {
            "type": "boolean"
          },
          "providers": {
            "type": "object",
            "required": [
              "coinbase",
              "geoip"
            ],
            "properties": {
              "coinbase": {
                "$ref": "#/components/schemas/ProviderHealth"
              },
              "geoip": {
                "$ref": "#/components/schemas/ProviderHealth"
              }
            }
          }
        }
      }
    },
    "responses": {
      "CrossOriginRequest": {
        "description": "Browser requests whose Origin host does not match Host are rejected. Reverse proxies must preserve the external Host header.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}
