                    "added_rows": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Rows added during the completed import."
                    },
                    "updated_rows": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Rows updated during the completed import."
                    },
                    "skipped_rows": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Rows skipped as invalid during the completed import."
                    }
                  }
